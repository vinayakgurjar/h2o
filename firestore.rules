rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authentication & Authorization Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Multi-factor Admin authorization:
    // 1. Custom Claims token check (token.role / token.admin)
    // 2. Primary Owner/Super Admin email check
    // 3. Firestore user document role verification
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'] ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'vinayakgurjar05@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'])
      );
    }

    // 1. User Accounts & Profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. B2B Leads & Public Inquiries
    // Public landing page submissions can create leads with required contact details
    match /leads/{leadId} {
      allow create: if request.resource.data.contactName is string &&
                       request.resource.data.phone is string;
      allow read, update, delete: if isAuthenticated();
    }

    // 3. Customers
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Quotations
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() || (request.query.limit <= 1);
      allow write: if isAuthenticated();
    }

    // 5. Orders & Artwork Approvals
    match /orders/{orderId} {
      allow read: if isAuthenticated() || (request.query.limit <= 1);
      allow write: if isAuthenticated();
    }

    // 6. Products Catalog & Inventory
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /production_jobs/{jobId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Statutory Badges & Company Branding
    match /compliance_records/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /company_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Immutable Enterprise Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
